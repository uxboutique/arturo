# Contact form ("Parla con un consulente") delivery.
# Set ONE of the two. With neither set, the form validates but reports
# that sending is not configured instead of pretending to succeed.

# POST endpoint that accepts JSON: { name, email, company, message, plan }
VITE_CONTACT_ENDPOINT=

# Fallback: opens the visitor's mail client addressed to this inbox.
VITE_CONTACT_EMAIL=

# Optional legal pages linked from the footer. Left empty, the footer
# items render as plain text rather than dead links.
VITE_PRIVACY_URL=
VITE_COOKIE_URL=
